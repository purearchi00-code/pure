# ============================================================
# D.A.R.I MVP — 환경 변수 템플릿
# ============================================================
# 이 파일을 .env.local로 복사한 뒤 키를 채우세요:
#   cp .env.example .env.local
#
# .env.local은 git에 커밋되지 않습니다 (.gitignore에 등록됨).
# ============================================================

# VWorld API (국토부 공간정보 오픈플랫폼)
# 발급: https://www.vworld.kr/dev/v4dv_apikeyManage_s001.do
# - 무료
# - 신청 후 즉시~1일 내 발급
# - 토지 지번·지목·면적·용도지역 조회 가능
VWORLD_API_KEY=

# 공공데이터포털 (data.go.kr)
# 발급: https://www.data.go.kr
# - 회원가입 후 "건축물대장정보 서비스" 활용신청
# - 일반 인증키 발급 (1-2일 검토)
# - 건폐율/용적률/구조/층수 등 건축물 상세 정보
DATA_GO_KR_API_KEY=

# Anthropic API (Claude)
# 발급: https://console.anthropic.com
# - 신용카드 등록 필요 (사용량 기반 과금)
# - 시민 자연어 → 구조화된 검토 결과 변환
ANTHROPIC_API_KEY=

# ============================================================
# 키가 비어 있으면 자동으로 mock 데이터 모드로 작동합니다.
# 한 개씩 채워가며 점진적으로 실제 API로 전환할 수 있습니다.
# ============================================================
